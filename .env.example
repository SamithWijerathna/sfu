# HTTP + Socket.IO backend
PORT=3850
NODE_ENV=production
FRONTEND_ORIGIN=https://meet.cloudwave.asia,http://localhost:3000,http://localhost:5173

# mediasoup public network config
# LISTEN_IP must be bindable on the server. Usually keep 0.0.0.0.
MEDIASOUP_LISTEN_IP=0.0.0.0
# ANNOUNCED_IP must be the public IP of the VPS, not domain, not 0.0.0.0.
MEDIASOUP_ANNOUNCED_IP=YOUR_SERVER_PUBLIC_IP
MEDIASOUP_MIN_PORT=50000
MEDIASOUP_MAX_PORT=60000

# Optional TURN fallback served by coturn container in docker-compose.turn.yml
# Use your own TURN domain or server public IP.
TURN_ENABLED=true
TURN_HOST=turn.yourdomain.com
TURN_PORT=3478
TURN_USERNAME=meetra
TURN_PASSWORD=change_this_strong_turn_password

# Required: must match the main API server's SFU_INTERNAL_SECRET.
INTERNAL_API_SECRET=CHANGE_THIS_INTERNAL_SECRET
