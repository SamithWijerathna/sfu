# Copy this into deploy/coturn/turnserver.conf and edit the IP/password.
listening-port=3478
tls-listening-port=5349

fingerprint
lt-cred-mech

realm=turn.meet.cloudwave.asia
server-name=turn.meet.cloudwave.asia
user=meetra:CHANGE_THIS_STRONG_PASSWORD

# Must be the public IP of the SFU/TURN VPS.
external-ip=YOUR_SFU_TURN_VPS_PUBLIC_IP

# TURN relay port range. Open this in UFW and provider firewall.
min-port=49160
max-port=49200

no-cli
no-tlsv1
no-tlsv1_1
log-file=stdout
simple-log
